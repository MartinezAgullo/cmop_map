# Configuración de la base de datos PostgreSQL/PostGIS
# For Docker deployment: DB_HOST=postgis
# For local development: DB_HOST=localhost (or 127.0.0.1)
DB_HOST=localhost # postgis
DB_PORT=5432
DB_NAME=cmop_db
DB_USER=postgres
DB_PASSWORD=postgres

# Configuración del servidor
PORT=3000
NODE_ENV=development
# Logging
# LOG_LEVEL: debug | info | warn | error  (debug adds static files, position updates, SSE broadcasts and notify payloads)
LOG_LEVEL=info
# LOG_FORMAT: pretty (coloured lines for a terminal) | json (one object per line, for log collectors)
LOG_FORMAT=pretty
# LOG_VIEWER: on | off  (the live log page at /logs; it has no authentication)
LOG_VIEWER=on
# LOG_BUFFER_SIZE: entries the /logs page receives when it opens
LOG_BUFFER_SIZE=1000

# Dependency monitor (postgres, planner, pfc_agent, vision_agent)
# DEPS_STARTUP_GRACE_MS: how long the agents may stay unreachable after startup before it is a warning
DEPS_STARTUP_GRACE_MS=60000
# DEPS_CHECK_INTERVAL_MS: how often every dependency is probed; only state changes are logged
DEPS_CHECK_INTERVAL_MS=10000
